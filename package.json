{
  "name": "hc-lite",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start -H 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "node scripts/migrate-database.mjs",
    "db:init-owner": "node scripts/init-owner.mjs",
    "db:init-member": "node scripts/init-member.mjs",
    "db:migrate-company-configs": "node scripts/migrate-company-configs.mjs",
    "db:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-portable-postgres.ps1",
    "db:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/stop-portable-postgres.ps1",
    "check": "npm test && npm run typecheck && npm run lint && npm run build"
  },
  "dependencies": {
    "@alicloud/credentials": "^2.4.5",
    "@langchain/core": "1.2.4",
    "@langchain/langgraph": "1.4.8",
    "@langchain/langgraph-checkpoint-postgres": "1.0.4",
    "@langchain/openai": "1.5.5",
    "@node-rs/jieba": "2.0.1",
    "ali-oss": "^6.23.0",
    "bcryptjs": "2.4.3",
    "busboy": "1.6.0",
    "graceful-fs": "^4.2.11",
    "lucide-react": "0.400.0",
    "next": "15.5.21",
    "pg": "8.22.0",
    "react": "19.1.2",
    "react-dom": "19.1.2",
    "server-only": "0.0.1",
    "undici": "7.29.0",
    "uuid": "11.1.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/ali-oss": "^6.23.3",
    "@types/bcryptjs": "2.4.6",
    "@types/busboy": "1.5.4",
    "@types/node": "20.19.43",
    "@types/pg": "8.20.0",
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "autoprefixer": "10.5.1",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.21",
    "postcss": "8.5.23",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  },
  "overrides": {
    "nanoid": "3.3.17",
    "postcss": "8.5.23",
    "sharp": "0.35.3"
  }
}
